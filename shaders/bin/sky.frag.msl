#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UniformBuffer
{
    float4 Sun;
    float4 SkyTop;
    float4 SkyHorizon;
    float4 Ambient;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
    float4 out_var_SV_Target1 [[color(1)]];
};

struct main0_in
{
    float3 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_UniformBuffer& UniformBuffer [[buffer(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(mix(UniformBuffer.SkyHorizon.xyz, UniformBuffer.SkyTop.xyz, float3((precise::atan2(in.in_var_TEXCOORD0.y, length(in.in_var_TEXCOORD0.xz)) + 1.57079637050628662109375) * 0.3183098733425140380859375)), 1.0);
    out.out_var_SV_Target1 = float4(0.0);
    return out;
}

